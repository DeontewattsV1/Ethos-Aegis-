# ── Ethos Aegis — environment variables ──────────────────────────────────────
# Copy to .env.production (gitignored) and fill in real values.
# NEVER commit this file with real secrets filled in.

# ── Core ──────────────────────────────────────────────────────────────────────
AEGIS_ENV=production
AEGIS_LOG_LEVEL=WARNING
PORT=8080

# ── Cryptography (VaultKeeper passphrase) ─────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AEGIS_PASSPHRASE=CHANGE_ME_generate_a_strong_random_secret

# ── LLM / API keys ────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# ── Instagram / Meta AI Studio ────────────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_VERIFY_TOKEN=
META_APP_SECRET=

# ── Webhook / integration secrets ─────────────────────────────────────────────
WEBHOOK_SECRET=

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=
POSTHOG_API_KEY=
