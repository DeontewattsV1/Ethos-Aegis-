# ==========================
# ETHOS-AEGIS SAFE AUTO MERGE
# ==========================

# Clone fresh copy
cd ~/Desktop
git clone https://github.com/DeontewattsV1/Ethos-Aegis-.git
cd Ethos-Aegis-

# Backup current state
git checkout main
git pull origin main
git branch backup-main-$(date +%Y%m%d-%H%M%S)

# Fetch all remote branches
git fetch --all --prune

# Show branches
echo "=== REMOTE BRANCHES ==="
git branch -r

# Merge every remote branch into main safely
git checkout main

for branch in $(git branch -r | grep origin | grep -v HEAD | grep -v main | sed 's|origin/||'); do
    echo "Merging: $branch"
    git merge origin/$branch --no-ff -m "Merged branch: $branch" || true
done

# ==========================
# GRAPHICS FIX ENGINE
# ==========================

echo "Fixing image filename issues..."

# Normalize common image extensions
find . -type f \( -iname "*.PNG" -o -iname "*.JPG" -o -iname "*.JPEG" \) | while read file; do
    lower=$(echo "$file" | sed 's/\.PNG$/.png/i' | sed 's/\.JPG$/.jpg/i' | sed 's/\.JPEG$/.jpeg/i')
    if [ "$file" != "$lower" ]; then
        mv "$file" "$lower"
    fi
done

# Create assets folder if missing
mkdir -p assets/images

# Find orphaned images and move common repo images
find . -type f \( -iname "*.png" -o -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.gif" -o -iname "*.svg" \)

echo "Checking README image paths..."

# Auto-fix README relative image links
if [ -f README.md ]; then
    sed -i '' 's|](assets/|](./assets/|g' README.md
    sed -i '' 's|src="assets/|src="./assets/|g' README.md
fi

# Stage fixes
git add .

# Commit if changes exist
git diff --cached --quiet || git commit -m "Auto merge branches + graphics rendering fixes"

# Push to GitHub
git push origin main

echo "DONE."
