{
  "name": "@ethos-aegis/sdk",
  "version": "1.0.0",
  "description": "Node.js SDK for the Ethos Aegis Sovereign Integrity Mesh \u2014 subprocess + HTTP transport",
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "require": "./src/index.js",
      "import": "./src/index.mjs"
    }
  },
  "scripts": {
