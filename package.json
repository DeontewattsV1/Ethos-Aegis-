{
  "name": "living-docs-template",
  "version": "0.1.1",
  "description": "Self-demonstrating, always-current documentation scaffold for the Ethos Aegis codebase.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "docs": "tsx scripts/sync-readme.ts && tsx scripts/run-examples.ts && tsx scripts/sync-readme.ts",
    "docs:api": "typedoc --out docs/api src/index.ts",
    "verify": "tsx scripts/run-examples.ts && tsx scripts/validate-docs.ts",
    "repl": "tsx repl.ts",
    "examples:run": "tsx scripts/run-examples.ts",
    "lint": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "ci": "npm ci && npm run lint && npm test && npm run verify && npm run build",
    "upgrade": "tsx scripts/upgrade.ts",
    "upgrade:dry": "tsx scripts/upgrade.ts --dry-run"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.1",
    "tsx": "^4.22.3",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "living-docs",
    "documentation",
    "typescript",
    "observable",
    "event-emitter"
  ],
  "overrides": {
    "vite": "8.0.16",
    "nanoid": "3.3.18",
    "brace-expansion": "5.0.9",
    "linkify-it": "5.0.2",
    "postcss": "8.5.23"
  }
}
